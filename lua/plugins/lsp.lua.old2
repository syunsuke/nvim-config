return {

    -------------------------------
    -- mason.nvimの設定
    -------------------------------
    {
        "mason-org/mason.nvim",
        build = ":MasonUpdate",
        cmd = { "Mason", "MasonUpdate", "MasonLog", "MasonInstall", "MasonUninstall", "MasonUninstallAll" },
        config = true,
        opts = {
                ui = {border = "rounded",
                      width = 0.8, height = 0.8,
                     },
                },
    },

    -------------------------------
    -- mason-lspconfig.nvimの設定
    -------------------------------
    {
        "mason-org/mason-lspconfig.nvim",
        dependencies = {
            { "mason-org/mason.nvim" },
            { "neovim/nvim-lspconfig" },
        },
        opts = {
                ensure_installed = { "lua_ls",  "clangd" },
                automatic_enable = false,
                },
        event = { "BufReadPre", "BufNewFile" },
        config = function(_, opts)
            require("mason").setup()
            require("mason-lspconfig").setup(opts)

            -- ★ サーバ個別設定は vim.lsp.config で
            vim.lsp.config('lua_ls', {
                settings = { Lua = { diagnostics = { globals = { "vim", "conky" } } } },
            })

        end,

    },

    -------------------------------
    -- mason-lspconfig.nvimの外部でHLSは管理
    -------------------------------
    {
        "neovim/nvim-lspconfig",
        config = function()
            local util = require("lspconfig").util

            vim.lsp.config("hls", {
                cmd = { "haskell-language-server-wrapper", "--lsp" },
                --root_dir = util.root_pattern("hie.yaml", "stack.yaml", "cabal.project", "package.yaml", ".git"),
                settings = {
                    haskell = {
                        formattingProvider = "ormolu",
                    },
                },
            })

            vim.lsp.enable("hls") -- ★ 明示的に有効化


            -- Ruff (Ruff 本体の LSP: `ruff server`)
            vim.lsp.config('ruff', {
                cmd = { 'ruff', 'server' },                -- venv に入れたならフルパスに置き換え可
                root_markers = { 'pyproject.toml', 'ruff.toml', '.git' },

                on_attach = function(client, bufnr)
                    -- Pyright/Basedpyright と併用時、Hover はそちらに任せたいなら無効化
                    client.server_capabilities.hoverProvider = false

                    -- 保存時に Ruff の自動修正（Fix All）を適用したい場合
                    vim.api.nvim_create_autocmd('BufWritePre', {
                        buffer = bufnr,
                        callback = function()
                            vim.lsp.buf.code_action({
                                apply = true,
                                context = { only = { 'source.fixAll.ruff' } },
                            })
                        end,
                    })
                end,
            })

            -- 初回だけどこか（例: init.lua）で有効化
            vim.lsp.enable('ruff')


            -- 型チェック (basedpyright) — pyrightでもOK
            vim.lsp.config('basedpyright', {
                cmd = { 'basedpyright-langserver', '--stdio' },  -- venvならフルパス
                root_markers = { 'pyproject.toml', 'setup.cfg', '.git' },
                settings = {
                    basedpyright = {
                        analysis = {
                            typeCheckingMode = 'standard',   -- 'off' | 'basic' | 'standard' | 'strict'
                            autoImportCompletions = true,
                        },
                    },
                },
            })

            -- 有効化（この2行を init.lua 等から一度呼べばOK）
            --vim.lsp.enable('ruff_lsp')
            vim.lsp.enable('basedpyright')

        end,
    },
    -- Lspsagaの設定
    {
        'nvimdev/lspsaga.nvim',
        dependencies = {'nvim-treesitter/nvim-treesitter', 'nvim-tree/nvim-web-devicons' },
        enabled = true,
        config = function()
            require('lspsaga').setup({})

            vim.keymap.set('n', 'K', '<cmd>Lspsaga hover_doc<CR>')
            vim.keymap.set('n', 'gr', '<cmd>Lspsaga finder<CR>')
            vim.keymap.set('n', 'ga', '<cmd>Lspsaga code_action<CR>')

        end,
    },


}
